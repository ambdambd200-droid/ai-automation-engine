{
  "name": "Render to Telegram Bridge",
  "description": "Receives webhooks from the AI Automation Engine (Render) and forwards them to Telegram. Used when a contact is approved and you want an instant Telegram notification.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "render-notify",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "id": "render-webhook"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body || $input.first().json;\nconst contact = data.contact || {};\nconst message = `\nNew inquiry approved and sent\n\nFrom: ${contact.name}\nEmail: ${contact.email}\nService: ${contact.service}\nMessage: ${contact.message ? contact.message.substring(0, 200) : ''}...\n\nStatus: ${data.status || 'sent'}\nAt: ${new Date().toISOString()}\n`.trim();\nreturn [{ json: { chat_id: $env.TELEGRAM_CHAT_ID, text: message }}];"
      },
      "name": "Format Telegram Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "id": "format"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [640, 300],
      "id": "telegram-send"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json.body || $input.first().json;\nconst decision = data.decision || {};\nconst message = `\nAI Brain Decision\n\nWorkflow: ${decision.workflow}\nTask: ${decision.task_type}\nConfidence: ${(decision.confidence || 0) * 100}%\nReasoning: ${decision.reasoning || 'n/a'}\n\nAction: Auto-routed\n`.trim();\nreturn [{ json: { chat_id: $env.TELEGRAM_CHAT_ID, text: message }}];"
      },
      "name": "Format Decision Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 480],
      "id": "format-decision"
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict"},
          "conditions": [
            {
              "leftValue": "={{ $('Webhook').first().json.body.type }}",
              "rightValue": "decision",
              "operator": {"type": "string", "operation": "equals"}
            }
          ],
          "combinator": "and"
        }
      },
      "name": "Is Decision?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 180],
      "id": "is-decision"
    }
  ],
  "connections": {
    "Webhook": {"main": [[{"node": "Is Decision?", "type": "main", "index": 0}]]},
    "Is Decision?": {"main": [
      [{"node": "Format Telegram Message", "type": "main", "index": 0}],
      [{"node": "Format Decision Alert", "type": "main", "index": 0}]
    ]},
    "Format Telegram Message": {"main": [[{"node": "Send to Telegram", "type": "main", "index": 0}]]},
    "Format Decision Alert": {"main": [[{"node": "Send to Telegram", "type": "main", "index": 0}]]}
  },
  "settings": {"executionOrder": "v1"},
  "staticData": null,
  "tags": [{"name": "render"}, {"name": "telegram"}, {"name": "notification"}],
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Built by Salim Muhammad · salim.muhammad.work0@gmail.com",
    "instanceId": "demo-004"
  }
}
